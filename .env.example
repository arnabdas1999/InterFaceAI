# Copy to .env (git-ignored). Only `cua discover` needs a model key; replay never calls a model.

# --- Discovery planner: pick ONE -------------------------------------------------------
# Option A (free): Google Gemini API free tier. Key from https://aistudio.google.com/apikey
CUA_PLANNER=gemini
GEMINI_API_KEY=
CUA_MODEL=gemini-3.8-flash        # newest Flash with free-tier quota (Pro models have free quota 0)

# Option B: Anthropic Claude (paid API).
# CUA_PLANNER=anthropic
# ANTHROPIC_API_KEY=
# CUA_MODEL=claude-sonnet-5

# Option C: any other OpenAI-compatible endpoint (Ollama, Groq, OpenRouter, ...).
# CUA_PLANNER=openai_compat
# CUA_OPENAI_BASE_URL=http://localhost:11434/v1
# CUA_OPENAI_API_KEY=ollama
# CUA_MODEL=<a vision + tool-calling model>

# Optional: reasoning effort passed to OpenAI-compatible providers that support it (low|medium|high).
# CUA_REASONING_EFFORT=low
# Hard cap on input+output tokens for one discovery run.
CUA_MAX_RUN_TOKENS=400000

# --- Synthetic target app (local, fake operator account - not a real credential) --------
CUA_TARGET_URL=http://127.0.0.1:8765
CUA_SECRET_SYNTHCORE_OPERATOR_USERNAME=operator1
CUA_SECRET_SYNTHCORE_OPERATOR_PASSWORD=synthetic-only-pass

# Key for correlation hashes in logs. If unset, a random key is generated per machine in .cua/.
# CUA_HMAC_KEY=

# Operator API port used by a live run (handoff / approvals).
CUA_OPERATOR_PORT=8766
