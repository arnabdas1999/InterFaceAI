{
  "patch_id": "synthcore/open-sub-account.commit@1",
  "description": "Irreversible commit of a new sub-account from the review screen. Authored and reviewed by an engineer: the model is never allowed to learn irreversible steps by performing them.",
  "author": "platform-engineer (reviewed)",
  "append_steps": [
    {
      "id": "c1",
      "description": "Click 'Open Account' to commit the new sub-account",
      "provenance": "authored",
      "action": "click",
      "target": {
        "description": "Open Account button on the review screen",
        "candidates": [
          {"strategy": "role_name", "role": "button", "name": "Open Account", "score": 0.9, "rationale": "Commit button caption on the SynthCore review screen; reviewed."}
        ]
      },
      "risk_class": "irreversible",
      "idempotent": false,
      "precondition": {
        "kind": "all_of",
        "conditions": [
          {"kind": "url_matches", "route": "/members/:member_id/subaccounts/review", "params_equal": {"member_id": {"from_input": "member_id"}}},
          {"kind": "text_in_region", "pattern": "Review New Sub-Account"}
        ]
      },
      "postcondition": {"kind": "text_in_region", "pattern": "Sub-Account Opened"},
      "timeout_ms": 15000,
      "review_notes": ["irreversible: executed only with a single-use, hash-bound human approval"],
      "on_success": "end"
    }
  ],
  "extract": [
    {
      "output": "confirmation_number",
      "after_step": "c1",
      "target": {
        "description": "value cell labelled 'Confirmation Number'",
        "candidates": [
          {"strategy": "label_anchor", "anchor_text": "Confirmation Number", "control": "cell", "score": 0.8, "rationale": "Value beside its label on the confirmation page."}
        ]
      },
      "type": "string",
      "sensitivity": "public"
    },
    {
      "output": "new_account_last4",
      "after_step": "c1",
      "target": {
        "description": "value cell labelled 'New Account'",
        "candidates": [
          {"strategy": "label_anchor", "anchor_text": "New Account", "control": "cell", "score": 0.8, "rationale": "Only the last four digits are displayed and extracted."}
        ]
      },
      "capture": "ending in (\\d{4})",
      "type": "string",
      "sensitivity": "pii_low"
    }
  ],
  "add_outputs": {
    "confirmation_number": {"type": "string", "pattern": "^CNF-\\d{6}$", "x-sensitivity": "public"},
    "new_account_last4": {"type": "string", "pattern": "^\\d{4}$", "x-sensitivity": "pii_low"}
  },
  "side_effects": "irreversible",
  "success": {
    "description": "Confirmation page shows 'Sub-Account Opened' for the input member",
    "checks": [
      {"kind": "url_matches", "route": "/members/:member_id/subaccounts/commit", "params_equal": {"member_id": {"from_input": "member_id"}}},
      {"kind": "text_in_region", "pattern": "Sub-Account Opened"},
      {
        "kind": "text_in_region",
        "region": {"target": {"description": "value cell labelled 'Member ID'", "candidates": [
          {"strategy": "label_anchor", "anchor_text": "vocab:member_id", "control": "cell", "score": 0.8, "rationale": "Ties the confirmation to the input member."}
        ]}},
        "contains": {"from_input": "member_id"}
      }
    ]
  },
  "add_routes": ["/members/:member_id/subaccounts/commit"],
  "add_actions": ["click"],
  "form_action_routes": {"c1": "/members/:member_id/subaccounts/commit"}
}
