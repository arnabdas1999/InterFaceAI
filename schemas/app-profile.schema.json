    "AttributeLocator": {
      "additionalProperties": false,
      "properties": {
        "adapter_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Adapter Kinds",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "expected_count": {
          "default": 1,
          "title": "Expected Count",
          "type": "integer"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "strategy": {
          "const": "attribute",
          "default": "attribute",
          "title": "Strategy",
          "type": "string"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        }
      },
      "required": [
        "score",
        "rationale",
        "tag",
        "attributes"
      ],
      "title": "AttributeLocator",
      "type": "object"
    },
    "CatalogState": {
      "additionalProperties": false,
      "properties": {
        "applies_after_submit_on": {
          "items": {
            "type": "string"
          },
          "title": "Applies After Submit On",
          "type": "array"
        },
        "classification": {
          "enum": [
            "business_outcome",
            "recoverable",
            "hard_failure"
          ],
          "title": "Classification",
          "type": "string"
        },
        "default_outcome_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Outcome Code"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "detector": {
          "discriminator": {
            "mapping": {
              "all_of": "#/$defs/AllOf",
              "any_of": "#/$defs/AnyOf",
              "dialog_present": "#/$defs/DialogPresent",
              "element_absent": "#/$defs/ElementAbsent",
              "element_present": "#/$defs/ElementPresent",
              "frame_loaded": "#/$defs/FrameLoaded",
              "http_status": "#/$defs/HttpStatusIs",
              "not": "#/$defs/Not",
              "text_in_region": "#/$defs/TextInRegion",
              "url_matches": "#/$defs/UrlMatches"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UrlMatches"
            },
            {
              "$ref": "#/$defs/ElementPresent"
            },
            {
              "$ref": "#/$defs/ElementAbsent"
            },
            {
              "$ref": "#/$defs/TextInRegion"
            },
            {
              "$ref": "#/$defs/FrameLoaded"
            },
            {
              "$ref": "#/$defs/DialogPresent"
            },
            {
              "$ref": "#/$defs/HttpStatusIs"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ],
          "title": "Detector"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "handler": {
          "anyOf": [
            {
              "$ref": "#/$defs/Handler"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "message_region": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recovery_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovery Code"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "global",
            "step"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "detector",
        "classification",
        "scope"
      ],
      "title": "CatalogState",
      "type": "object"
    },
    "CoordinateLocator": {
      "additionalProperties": false,
      "description": "Last resort for surfaces with no addressable controls. Always flagged for review.",
      "properties": {
        "adapter_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Adapter Kinds",
          "type": "array"
        },
        "expected_count": {
          "default": 1,
          "title": "Expected Count",
          "type": "integer"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "strategy": {
          "const": "coordinate",
          "default": "coordinate",
          "title": "Strategy",
          "type": "string"
        },
        "viewport": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Viewport",
          "type": "array"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "score",
        "rationale",
        "x",
        "y",
        "viewport"
      ],
      "title": "CoordinateLocator",
      "type": "object"
    },
    "DialogPresent": {
      "additionalProperties": false,
      "properties": {
        "dialog_type": {
          "default": "any",
          "enum": [
            "alert",
            "confirm",
            "prompt",
            "beforeunload",
            "any"
          ],
          "title": "Dialog Type",
          "type": "string"
        },
        "kind": {
          "const": "dialog_present",
          "default": "dialog_present",
          "title": "Kind",
          "type": "string"
        },
        "text_pattern": {
          "title": "Text Pattern",
          "type": "string"
        }
      },
      "required": [
        "text_pattern"
      ],
      "title": "DialogPresent",
      "type": "object"
    },
    "ElementAbsent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "element_absent",
          "default": "element_absent",
