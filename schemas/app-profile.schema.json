          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetSpec"
        }
      },
      "required": [
        "target"
      ],
      "title": "ElementAbsent",
      "type": "object"
    },
    "ElementPresent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "element_present",
          "default": "element_present",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetSpec"
        }
      },
      "required": [
        "target"
      ],
      "title": "ElementPresent",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
      "properties": {
        "generator_pattern": {
          "title": "Generator Pattern",
          "type": "string"
        },
        "product": {
          "title": "Product",
          "type": "string"
        },
        "required_anchor_texts": {
          "items": {
            "type": "string"
          },
          "title": "Required Anchor Texts",
          "type": "array"
        },
        "version_range": {
          "title": "Version Range",
          "type": "string"
        }
      },
      "required": [
        "product",
        "generator_pattern",
        "version_range"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "FrameLoaded": {
      "additionalProperties": false,
      "properties": {
        "frame_path": {
          "items": {
            "$ref": "#/$defs/FrameRef"
          },
          "title": "Frame Path",
          "type": "array"
        },
        "kind": {
          "const": "frame_loaded",
          "default": "frame_loaded",
          "title": "Kind",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        }
      },
      "required": [
        "frame_path"
      ],
      "title": "FrameLoaded",
      "type": "object"
    },
    "FrameRef": {
      "additionalProperties": false,
      "description": "One hop into a nested frame/window. Matched by name first, then by route pattern.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        }
      },
      "title": "FrameRef",
      "type": "object"
    },
    "Handler": {
      "additionalProperties": false,
      "description": "A bounded, named, deterministic response to a known state.",
      "properties": {
        "backoff_ms": {
          "default": 500,
          "title": "Backoff Ms",
          "type": "integer"
        },
        "dialog_response": {
          "anyOf": [
            {
              "enum": [
                "accept",
                "dismiss"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dialog Response"
        },
        "kind": {
          "enum": [
            "dismiss",
            "dialog",
            "reauthenticate",
            "retry_step",
            "wait"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_attempts": {
          "default": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wait_timeout_ms": {
          "default": 10000,
          "title": "Wait Timeout Ms",
          "type": "integer"
        },
        "wait_until": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "all_of": "#/$defs/AllOf",
                  "any_of": "#/$defs/AnyOf",
                  "dialog_present": "#/$defs/DialogPresent",
                  "element_absent": "#/$defs/ElementAbsent",
                  "element_present": "#/$defs/ElementPresent",
                  "frame_loaded": "#/$defs/FrameLoaded",
                  "http_status": "#/$defs/HttpStatusIs",
                  "not": "#/$defs/Not",
                  "text_in_region": "#/$defs/TextInRegion",
                  "url_matches": "#/$defs/UrlMatches"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/UrlMatches"
                },
                {
                  "$ref": "#/$defs/ElementPresent"
                },
                {
                  "$ref": "#/$defs/ElementAbsent"
                },
                {
                  "$ref": "#/$defs/TextInRegion"
                },
                {
                  "$ref": "#/$defs/FrameLoaded"
                },
                {
                  "$ref": "#/$defs/DialogPresent"
                },
                {
                  "$ref": "#/$defs/HttpStatusIs"
                },
                {
                  "$ref": "#/$defs/AllOf"
                },
                {
                  "$ref": "#/$defs/AnyOf"
                },
                {
                  "$ref": "#/$defs/Not"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Until"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Handler",
      "type": "object"
    },
    "HttpStatusIs": {
      "additionalProperties": false,
      "description": "Last main-document (or frame document) response status in the given class, e.g. 5xx.",
      "properties": {
        "frame_path": {
          "items": {
            "$ref": "#/$defs/FrameRef"
          },
          "title": "Frame Path",
          "type": "array"
        },
        "kind": {
          "const": "http_status",
          "default": "http_status",
          "title": "Kind",
          "type": "string"
        },
        "status_class": {
          "enum": [
            "4xx",
            "5xx"
          ],
          "title": "Status Class",
          "type": "string"
        }
      },
      "required": [
        "status_class"
      ],
      "title": "HttpStatusIs",
      "type": "object"
    },
    "LabelAnchorLocator": {
      "additionalProperties": false,
      "description": "A control located relative to visible label text, e.g. the input in the table row whose\nheader cell reads \"Member ID:\". Works on legacy markup that has no <label> or aria wiring.\n``control=\"cell\"`` targets the value cell itself (used by extractors and checkpoints).",
      "properties": {
        "adapter_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Adapter Kinds",
          "type": "array"
        },
        "anchor_text": {
          "title": "Anchor Text",
          "type": "string"
        },
        "control": {
          "enum": [
            "input",
            "select",
            "button",
            "link",
            "checkbox",
            "cell"
          ],
          "title": "Control",
          "type": "string"
        },
        "expected_count": {
          "default": 1,
          "title": "Expected Count",
          "type": "integer"
        },
        "input_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Type"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "relation": {
          "const": "same_row_following",
          "default": "same_row_following",
          "title": "Relation",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "strategy": {
          "const": "label_anchor",
          "default": "label_anchor",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "score",
        "rationale",
        "anchor_text",
        "control"
      ],
      "title": "LabelAnchorLocator",
      "type": "object"
    },
    "LoginRoutine": {
      "additionalProperties": false,
      "properties": {
        "route": {
          "title": "Route",
          "type": "string"
        },
        "secret_ref": {
          "title": "Secret Ref",
          "type": "string"
        },
        "session_valid": {
          "discriminator": {
            "mapping": {
              "all_of": "#/$defs/AllOf",
              "any_of": "#/$defs/AnyOf",
              "dialog_present": "#/$defs/DialogPresent",
              "element_absent": "#/$defs/ElementAbsent",
              "element_present": "#/$defs/ElementPresent",
              "frame_loaded": "#/$defs/FrameLoaded",
              "http_status": "#/$defs/HttpStatusIs",
              "not": "#/$defs/Not",
              "text_in_region": "#/$defs/TextInRegion",
              "url_matches": "#/$defs/UrlMatches"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UrlMatches"
            },
            {
              "$ref": "#/$defs/ElementPresent"
            },
            {
              "$ref": "#/$defs/ElementAbsent"
            },
            {
              "$ref": "#/$defs/TextInRegion"
            },
            {
              "$ref": "#/$defs/FrameLoaded"
            },
            {
              "$ref": "#/$defs/DialogPresent"
            },
            {
              "$ref": "#/$defs/HttpStatusIs"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ],
          "title": "Session Valid"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/LoginStep"
          },
          "title": "Steps",
          "type": "array"
        },
        "success": {
          "discriminator": {
            "mapping": {
              "all_of": "#/$defs/AllOf",
              "any_of": "#/$defs/AnyOf",
              "dialog_present": "#/$defs/DialogPresent",
              "element_absent": "#/$defs/ElementAbsent",
              "element_present": "#/$defs/ElementPresent",
              "frame_loaded": "#/$defs/FrameLoaded",
              "http_status": "#/$defs/HttpStatusIs",
              "not": "#/$defs/Not",
              "text_in_region": "#/$defs/TextInRegion",
              "url_matches": "#/$defs/UrlMatches"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UrlMatches"
            },
            {
              "$ref": "#/$defs/ElementPresent"
            },
            {
              "$ref": "#/$defs/ElementAbsent"
            },
            {
              "$ref": "#/$defs/TextInRegion"
            },
            {
              "$ref": "#/$defs/FrameLoaded"
            },
            {
              "$ref": "#/$defs/DialogPresent"
            },
            {
              "$ref": "#/$defs/HttpStatusIs"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ],
          "title": "Success"
        }
      },
      "required": [
        "route",
        "secret_ref",
        "steps",
        "success",
        "session_valid"
      ],
      "title": "LoginRoutine",
      "type": "object"
    },
    "LoginStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "type",
            "click"
          ],
          "title": "Action",
          "type": "string"
        },
        "secret_field": {
          "anyOf": [
            {
              "enum": [
                "username",
                "password"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secret Field"
        },
        "target": {
          "$ref": "#/$defs/TargetSpec"
        }
      },
      "required": [
        "action",
        "target"
      ],
      "title": "LoginStep",
      "type": "object"
    },
    "Not": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "discriminator": {
            "mapping": {
              "all_of": "#/$defs/AllOf",
              "any_of": "#/$defs/AnyOf",
              "dialog_present": "#/$defs/DialogPresent",
              "element_absent": "#/$defs/ElementAbsent",
              "element_present": "#/$defs/ElementPresent",
              "frame_loaded": "#/$defs/FrameLoaded",
              "http_status": "#/$defs/HttpStatusIs",
              "not": "#/$defs/Not",
              "text_in_region": "#/$defs/TextInRegion",
              "url_matches": "#/$defs/UrlMatches"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UrlMatches"
            },
            {
              "$ref": "#/$defs/ElementPresent"
            },
            {
              "$ref": "#/$defs/ElementAbsent"
            },
            {
              "$ref": "#/$defs/TextInRegion"
            },
            {
              "$ref": "#/$defs/FrameLoaded"
            },
            {
              "$ref": "#/$defs/DialogPresent"
            },
            {
              "$ref": "#/$defs/HttpStatusIs"
