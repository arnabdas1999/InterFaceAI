    "LabelAnchorLocator": {
      "additionalProperties": false,
      "description": "A control located relative to visible label text, e.g. the input in the table row whose\nheader cell reads \"Member ID:\". Works on legacy markup that has no <label> or aria wiring.\n``control=\"cell\"`` targets the value cell itself (used by extractors and checkpoints).",
      "properties": {
        "adapter_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Adapter Kinds",
          "type": "array"
        },
        "anchor_text": {
          "title": "Anchor Text",
          "type": "string"
        },
        "control": {
          "enum": [
            "input",
            "select",
            "button",
            "link",
            "checkbox",
            "cell"
          ],
          "title": "Control",
          "type": "string"
        },
        "expected_count": {
          "default": 1,
          "title": "Expected Count",
          "type": "integer"
        },
        "input_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Type"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "relation": {
          "const": "same_row_following",
          "default": "same_row_following",
          "title": "Relation",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "strategy": {
          "const": "label_anchor",
          "default": "label_anchor",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "score",
        "rationale",
        "anchor_text",
        "control"
      ],
      "title": "LabelAnchorLocator",
      "type": "object"
    },
