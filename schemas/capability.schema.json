    "Contract": {
      "additionalProperties": false,
      "description": "What a calling agent sees. ``inputs``/``outputs`` are JSON Schema objects, so a contract\nmaps 1:1 to a tool definition.",
      "properties": {
        "business_outcomes": {
          "items": {
            "$ref": "#/$defs/BusinessOutcomeDecl"
          },
          "title": "Business Outcomes",
          "type": "array"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "side_effects": {
          "enum": [
            "none",
            "reversible",
            "irreversible"
          ],
