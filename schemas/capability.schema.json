        "strategy": {
          "const": "coordinate",
          "default": "coordinate",
          "title": "Strategy",
          "type": "string"
        },
        "viewport": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
