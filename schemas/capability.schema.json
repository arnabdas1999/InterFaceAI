          "type": "string"
        }
      },
      "required": [
        "inputs",
        "outputs",
        "side_effects"
      ],
      "title": "Contract",
      "type": "object"
    },
    "CoordinateLocator": {
      "additionalProperties": false,
      "description": "Last resort for surfaces with no addressable controls. Always flagged for review.",
